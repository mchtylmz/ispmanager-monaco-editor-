  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-preview.mjs",
    "test:unit": "node --test tests/frontend.test.mjs",
    "package:preview": "python3 -I -B tools/package_preview.py",
