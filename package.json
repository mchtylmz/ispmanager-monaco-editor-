    "package:plugin": "python3 -I -B tools/package_plugin.py",
    "package:standalone": "python3 -I -B tools/package_standalone.py",
    "test:editor": "node --test tests/frontend.test.mjs tests/native-bridge.test.mjs tests/editor-bridge.test.mjs tests/preferences.test.mjs tests/fullscreen.test.mjs tests/tag-pairs.test.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "ace-builds": "1.45.2",
